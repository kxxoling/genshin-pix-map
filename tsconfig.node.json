{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "jest.config.ts",
    "playwright.config.ts",
    "src/__tests__/e2e/**/*.ts"
  ]
}
